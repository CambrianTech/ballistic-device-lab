{
  "interval_seconds": 900,
  "remote": "origin",
  "branch": "main",
  "workers": [
    {
      "label": "Self-consistent graphene feedback",
      "module": "physics_layers.loaded_feedback_pilot",
      "status_glob": "runs/loaded-feedback-pilot*/status.json"
    },
    {
      "label": "Geometry search",
      "module": "ballistic_lab.pipeline.dc_continuous",
      "status_glob": "runs/dc-continuous/status.json"
    },
    {
      "label": "Atomic-edge sensitivity",
      "module": "edge_lab.worker",
      "status_glob": "runs/edge-sensitivity/status.json"
    }
  ],
  "completed_glob": "runs/loaded-feedback-pilot*/status.json",
  "adapters": [
    {
      "callable": "ballistic_lab.reporting.evolution_story:render",
      "block": "evolution",
      "options": {
        "snapshots": "runs/dc-continuous/round-*.json"
      }
    }
  ]
}
